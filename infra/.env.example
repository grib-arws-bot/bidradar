# 실제 값 채운 .env는 절대 커밋 금지 (.gitignore에 포함됨, ARWS에서 잔존 사고 있었음)

# PostgreSQL
POSTGRES_USER=bidradar
POSTGRES_PASSWORD=
POSTGRES_DB=bidradar

# 백엔드 세션 쿠키 서명 키 — 반드시 임의 무작위 문자열로 교체 (예: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# 단일 공유 계정(의사결정_로그 9번) — python -m app.cli create-admin 으로 생성 후 해시만 여기 보관
# ⚠️ argon2 해시는 $로 구간을 나눔. docker-compose가 .env의 $를 변수 참조로 해석하므로
# 그대로 붙여넣으면 깨진다 — 반드시 $를 $$로 두 배씩 이스케이프해서 넣을 것.
ADMIN_EMAIL=report@grib.co.kr
ADMIN_PASSWORD_HASH=

# 이후 단계에서 추가 예정
# ANTHROPIC_API_KEY=
# DATA_GO_KR_SERVICE_KEY=
